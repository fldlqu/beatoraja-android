<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/beatoraja_background"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/beatoraja_background"
        app:subtitle="设置与启动"
        app:subtitleTextColor="@color/beatoraja_on_surface_variant"
        app:title="@string/app_name"
        app:titleTextColor="@color/beatoraja_on_surface" />

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/settings_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/beatoraja_surface"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="进入游戏"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_scan"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="更新曲库"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/settings_rebuild"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="重建曲库"
            android:textAllCaps="false"
            android:textColor="@color/beatoraja_error" />
    </LinearLayout>
</LinearLayout>
